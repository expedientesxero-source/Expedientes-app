# Stripe Product Prices (create these in your Stripe dashboard)
STRIPE_PRICE_STARTER=price_1234567890
STRIPE_PRICE_PROFESSIONAL=price_0987654321
STRIPE_PRICE_ENTERPRISE=price_1122334455

# AI Service
OPENAI_API_KEY=sk_your_openai_key
AI_SERVICE_URL=https://api.openai.com/v1/chat/completions
